# REQUEST THROTTLING
#   Prevents rate-limiting and IDS/WAF detection during scans.
#   All delays are in seconds (decimals accepted, e.g. 0.3).
#   Set THROTTLE_ENABLED=0 to disable all delays (faster but louder).
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

THROTTLE_ENABLED=1

# Delay between HTTP requests (curl, httpx, web scanning tools)
THROTTLE_HTTP_DELAY=0.5

# Delay between port/service scan calls (nmap, masscan)
THROTTLE_SCAN_DELAY=0.0

# Delay between brute-force attempts (hydra, medusa, crackmapexec)
THROTTLE_BRUTE_DELAY=0.0

# Delay for all other tool calls
THROTTLE_DEFAULT_DELAY=0.0


# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
